# ==============================================================================
# TODOLIST BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=todolist_db
# Set to true when using cloud-hosted databases requiring TLS/SSL (e.g. TiDB Cloud, PlanetScale, Aiven, AWS RDS)
DB_SSL=false

# JWT Authentication Secret Key (change in production)
JWT_SECRET=todolist_super_secret_jwt_key_2026_dev
